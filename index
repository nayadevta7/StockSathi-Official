<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Stock Sathi – Premium App UI</title>

<style>
body{
margin:0;
font-family:Segoe UI, Arial;
background:radial-gradient(circle at top,#ede9ff,#d9d6ff,#c7c2f5);
overflow-y:auto;
}

/* ===== SIMPLE PREMIUM NAVBAR (ONLY HOME) ===== */
header{
position:sticky;
top:0;
padding:18px 30px;
display:flex;
justify-content:space-between;
align-items:center;
background:linear-gradient(90deg,rgba(255,255,255,0.6),rgba(255,255,255,0.3));
backdrop-filter:blur(16px);
box-shadow:0 10px 30px rgba(120,110,255,0.15);
z-index:50;
}

.logo{
font-size:20px;
font-weight:800;
color:#4c46e5;
}

nav a{
text-decoration:none;
color:#4338ca;
font-weight:700;
background:rgba(99,102,241,0.15);
padding:8px 16px;
border-radius:12px;
}

.main{
padding-top:90px;
display:flex;
justify-content:center;
align-items:center;
}

.app-wrap{
display:flex;
flex-wrap:wrap;
justify-content:center;
gap:60px;
padding:40px;
}

/* ===== SCREEN TITLE ABOVE PHONE ===== */
.phone-box{
display:flex;
flex-direction:column;
align-items:center;
}

.screen-name{
font-weight:700;
margin-bottom:14px;
color:#3730a3;
letter-spacing:0.4px;
transition:0.3s ease;
}

/* 🔥 ERROR GLOW EFFECT */
.phone-box.error .screen-name{
font-size:20px;
color:#4f46e5;
text-shadow:0 0 10px rgba(99,102,241,0.8),
0 0 20px rgba(139,92,246,0.7),
0 0 30px rgba(167,139,250,0.6);
transform:scale(1.15);
}

.phone{
width:280px;
height:560px;
border-radius:48px;
background:linear-gradient(145deg,#ffffff,#dcd8ff);
box-shadow:25px 25px 50px rgba(140,130,255,0.35),
-15px -15px 35px rgba(255,255,255,0.9);
padding:16px;
transition:0.35s;
}

.phone:hover{transform:translateY(-8px) scale(1.02);} 

/* 🔥 ERROR STATE – SCREEN + NAME GLOW */
.phone-box.error .phone{
transform:scale(1.06);
box-shadow:0 0 25px rgba(99,102,241,0.8),
0 0 50px rgba(139,92,246,0.6),
25px 25px 50px rgba(140,130,255,0.35),
-15px -15px 35px rgba(255,255,255,0.9);
}

.phone-box.error .screen{
box-shadow:inset 0 0 30px rgba(255,255,255,0.25),
0 0 40px rgba(99,102,241,0.9),
0 0 70px rgba(167,139,250,0.8);
}

.phone-box.error .screen-name{
font-size:22px;
color:#4f46e5;
text-shadow:0 0 10px rgba(99,102,241,0.8),
0 0 20px rgba(139,92,246,0.7),
0 0 30px rgba(167,139,250,0.6);
transform:scale(1.2);
}

.screen{
width:100%;
height:100%;
border-radius:36px;
padding:20px;
box-sizing:border-box;
background:linear-gradient(160deg,#6366f1,#8b5cf6,#c084fc);
color:white;
position:relative;
overflow:hidden;
}

.screen:after{
content:"";
position:absolute;
width:240px;
height:240px;
background:rgba(255,255,255,0.25);
border-radius:50%;
bottom:-90px;
left:-60px;
filter:blur(25px);
}

.app-title{
font-size:22px;
font-weight:700;
margin-bottom:18px;
}

.input{
background:rgba(255,255,255,0.25);
padding:14px;
border-radius:18px;
margin-bottom:14px;
backdrop-filter:blur(10px);
}

.card{
padding:16px;
border-radius:20px;
margin-bottom:14px;
background:rgba(255,255,255,0.22);
backdrop-filter:blur(14px);
box-shadow:0 10px 25px rgba(0,0,0,0.18);
font-size:14px;
}

.gradient-blue{background:linear-gradient(90deg,#60a5fa,#6366f1);}
.gradient-green{background:linear-gradient(90deg,#34d399,#10b981);}
.gradient-orange{background:linear-gradient(90deg,#fb7185,#f97316);}
.gradient-pink{background:linear-gradient(90deg,#f472b6,#a78bfa);}

.big-btn{
margin-top:18px;
padding:15px;
border-radius:26px;
text-align:center;
font-weight:700;
background:linear-gradient(90deg,#a78bfa,#6366f1);
box-shadow:0 12px 25px rgba(80,70,255,0.45);
}

.small-text{
text-align:center;
margin-top:12px;
font-size:12px;
opacity:0.9;
}

@media(max-width:700px){
.app-wrap{flex-direction:column;align-items:center;}
}
</style>
</head>

<body>

<header>
<div class="logo">Stock Sathi</div>
<nav>
<a href="#">Home</a>
</nav>
</header>

<div class="main">
<div class="app-wrap">

<div class="phone-box">
<div class="screen-name">Login Screen</div>
<div class="phone"><div class="screen">
<div class="app-title">Login</div>
<div class="input">Email</div>
<div class="input">Password</div>
<div class="big-btn">Login</div>
<div class="small-text">Create new account</div>
</div></div>
</div>

<div class="phone-box">
<div class="screen-name">Signup Screen</div>
<div class="phone"><div class="screen">
<div class="app-title">Sign Up</div>
<div class="input">Full Name</div>
<div class="input">Email</div>
<div class="input">Password</div>
<div class="big-btn">Create Account</div>
</div></div>
</div>

<div class="phone-box">
<div class="screen-name">Home Screen</div>
<div class="phone"><div class="screen">
<div class="app-title">StockSathi1</div>
<div class="card gradient-blue">Total Items : 0</div>
<div class="card gradient-green">Total Profit : ₹0</div>
<div class="card">+ Add Item</div>
<div class="card">View Items</div>
<div class="card gradient-pink">Reports</div>
</div></div>
</div>

<div class="phone-box">
<div class="screen-name">View Items Screen</div>
<div class="phone"><div class="screen">
<div class="app-title">View Items</div>
<div class="input">🔍 Search items...</div>
<div class="card">Blue Pen — Buy ₹5 | Sell ₹10 | Stock 50</div>
<div class="card">Calculator — Buy ₹300 | Sell ₹450 | Stock 20</div>
<div class="card">Orange Juice — Buy ₹25 | Sell ₹35 | Stock 40</div>
<div class="card">Headphones — Buy ₹600 | Sell ₹700 | Stock 15</div>
</div></div>
</div>

<div class="phone-box">
<div class="screen-name">Reports Screen</div>
<div class="phone"><div class="screen">
<div class="app-title">Reports</div>
<div class="card gradient-green">Total Profit ₹0</div>
<div class="card gradient-blue">Total Investment ₹0</div>
<div class="card gradient-orange">Stock Value ₹0</div>
</div></div>
</div>

</div>
</div>

</body>
</html>
